# Configuración del Backend - Select Dance Studio
PORT=5000
NODE_ENV=production

# Base de Datos
DB_HOST=db  # Usa 'db' si estás usando Docker, 'localhost' si usas XAMPP local
DB_USER=usuario_db
DB_PASSWORD=contraseña_db
DB_NAME=select_dance_db

# Seguridad
JWT_SECRET=tu_secreto_super_seguro_aqui

# Frontend URL (para CORS)
FRONTEND_URL=https://tu-dominio.com

# Web Push (opcional; si se omite usa ADMIN_EMAIL como contacto VAPID)
VAPID_SUBJECT=mailto:admin@tu-dominio.com

# Cámara IP / MediaMTX. Esta plantilla permanece privada; el panel reemplaza
# únicamente la IP cuando un administrador valida el Wi-Fi del estudio.
MEDIAMTX_API_URL=http://mediamtx:9997
MEDIAMTX_STREAM_KEY=live/estudio
CAMERA_RTSP_URL=rtsp://usuario:contraseña@203.0.113.10:554/live/ch00_1
CAMERA_RTSP_PORT=554

# WhatsApp / Twilio (Si aplica)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
